{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "planning/planning_profile.schema.json",
  "title": "PlanningProfile",
  "type": "object",
  "required": ["schema_version", "anchors", "readiness"],
  "properties": {
    "schema_version": { "type": "string" },
    "profile_id": { "type": "string" },
    "anchors": {
      "type": "object",
      "required": ["goal", "current"],
      "properties": {
        "goal": { "type": "string" },
        "current": { "type": "string" },
        "goal_clarity": { "type": "string", "enum": ["low", "medium", "high"] },
        "current_clarity": { "type": "string", "enum": ["low", "medium", "high"] }
      }
    },
    "stated_facts": {
      "type": "array",
      "items": { "$ref": "attributed_claim.schema.json" }
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
          "priority": { "type": "string", "enum": ["primary", "secondary"] },
          "time_horizon": { "type": "string" }
        }
      }
    },
    "current_state": { "type": "object" },
    "values_preferences": {
      "type": "array",
      "items": { "$ref": "attributed_claim.schema.json" }
    },
    "acceptable_costs": { "type": "object" },
    "unknowns": {
      "type": "array",
      "items": { "$ref": "attributed_claim.schema.json" }
    },
    "assumptions": {
      "type": "array",
      "items": { "$ref": "attributed_claim.schema.json" }
    },
    "inferences": {
      "type": "array",
      "items": { "$ref": "attributed_claim.schema.json" }
    },
    "readiness": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["collecting", "conditional", "ready"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "blocking_gaps": { "type": "array", "items": { "type": "string" } },
        "allow_proceed_with_assumptions": { "type": "boolean" }
      }
    },
    "provenance": { "type": "object" }
  }
}

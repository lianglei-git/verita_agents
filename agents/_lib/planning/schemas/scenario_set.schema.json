{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "planning/scenario_set.schema.json",
  "title": "ScenarioSet",
  "type": "object",
  "required": ["schema_version", "scenarios", "disclaimer"],
  "properties": {
    "schema_version": { "type": "string" },
    "set_id": { "type": "string" },
    "profile_id": { "type": "string" },
    "gap_diagnosis_id": { "type": "string" },
    "comparison_axes": { "type": "array", "items": { "type": "string" } },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["title", "archetype", "premises"],
        "properties": {
          "id": { "type": "string" },
          "archetype": {
            "type": "string",
            "enum": ["conservative", "balanced", "aggressive"]
          },
          "title": { "type": "string" },
          "tagline": { "type": "string" },
          "premises": {
            "type": "array",
            "items": { "$ref": "attributed_claim.schema.json" }
          },
          "key_decisions": { "type": "array", "items": { "type": "string" } },
          "staged_outcomes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "phase": { "type": "string" },
                "outcome": { "type": "string" },
                "timeframe": { "type": "string" }
              }
            }
          },
          "opportunity_costs": { "type": "array", "items": { "type": "string" } },
          "failure_modes": { "type": "array", "items": { "type": "string" } },
          "early_warning_signals": { "type": "array", "items": { "type": "string" } },
          "reversible_actions": { "type": "array", "items": { "type": "string" } },
          "confidence_notes": { "type": "string" }
        }
      }
    },
    "disclaimer": { "type": "string" },
    "selected_scenario_id": { "type": "string" },
    "selection_rationale": { "type": "string" }
  }
}

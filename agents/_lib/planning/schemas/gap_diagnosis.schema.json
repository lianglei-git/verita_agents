{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "planning/gap_diagnosis.schema.json",
  "title": "GapDiagnosis",
  "type": "object",
  "required": ["schema_version", "gaps"],
  "properties": {
    "schema_version": { "type": "string" },
    "diagnosis_id": { "type": "string" },
    "profile_id": { "type": "string" },
    "summary": { "type": "string" },
    "gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "baseline", "target_threshold"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["skill", "resource", "time", "credential", "network", "mindset", "other"]
          },
          "evidence": {
            "type": "array",
            "items": { "$ref": "attributed_claim.schema.json" }
          },
          "baseline": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "indicators": { "type": "array", "items": { "type": "string" } }
            }
          },
          "target_threshold": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "indicators": { "type": "array", "items": { "type": "string" } }
            }
          },
          "verifiable_metrics": { "type": "array", "items": { "type": "string" } },
          "priority": {
            "type": "string",
            "enum": ["blocking", "important", "optional"]
          },
          "closure_options": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["open", "partial", "closed"] }
        }
      }
    },
    "meta": { "type": "object" }
  }
}

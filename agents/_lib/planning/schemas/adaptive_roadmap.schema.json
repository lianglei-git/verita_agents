{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "planning/adaptive_roadmap.schema.json",
  "title": "AdaptiveRoadmap",
  "type": "object",
  "required": ["schema_version", "phases"],
  "properties": {
    "schema_version": { "type": "string" },
    "roadmap_id": { "type": "string" },
    "profile_id": { "type": "string" },
    "scenario_id": { "type": "string" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "goal", "milestones", "if_not_met"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "goal": { "type": "string" },
          "time_window": {
            "type": "object",
            "properties": {
              "label": { "type": "string", "enum": ["week", "month", "quarter", "year"] },
              "start": { "type": "string" },
              "end": { "type": "string" }
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "description": { "type": "string" },
                "effort": { "type": "string" },
                "owner": { "type": "string" }
              }
            }
          },
          "deliverables": { "type": "array", "items": { "type": "string" } },
          "success_thresholds": { "type": "array", "items": { "type": "string" } },
          "resource_costs": { "type": "object" },
          "milestones": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "description": { "type": "string" },
                "due": { "type": "string" },
                "verifiable": { "type": "boolean" }
              }
            }
          },
          "risk_signals": { "type": "array", "items": { "type": "string" } },
          "if_not_met": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "adjustments": { "type": "array", "items": { "type": "string" } }
            }
          },
          "review_checkpoint": {
            "type": "object",
            "properties": {
              "when": { "type": "string" },
              "questions": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": { "$ref": "attributed_claim.schema.json" }
    },
    "version": { "type": "integer", "minimum": 1 },
    "revision_log": { "type": "array" }
  }
}

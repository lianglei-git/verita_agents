{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tts.speak / text-to-speech",
  "description": "LS tts.speak：WAV 预签 PUT，output 只含元数据。工作台仍支持 stream SSE 与 full 整段资料。",
  "input": {
    "type": "object",
    "properties": {
      "request_id": { "type": "string" },
      "text": { "type": "string", "description": "待合成文本（LS tts.speak）" },
      "language": { "type": "string", "enum": ["en", "ja", "zh-CN"] },
      "voice": { "type": "string" },
      "upload": { "type": "object" },
      "mode": { "type": "string", "enum": ["stream", "full", "speak"], "default": "stream" }
    }
  },
  "output": {
    "type": "object",
    "properties": {
      "uploaded": { "type": "boolean" },
      "bytes": { "type": "integer" },
      "mime": { "const": "audio/wav" },
      "filename": { "const": "tts.wav" },
      "duration_sec": { "type": "number" }
    }
  },
  "sse_events": {
    "sentence_start": ["sentence_index", "text"],
    "audio_delta": ["sentence_index", "audio_b64", "mime", "sample_rate"],
    "sentence_end": ["sentence_index", "audio_url", "duration_ms"],
    "error": ["error"],
    "done": []
  }
}

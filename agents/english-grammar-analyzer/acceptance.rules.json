{
  "version": "1.0",
  "description": "Machine-readable rules for English Grammar Analyzer acceptance testing",
  "field_weights": {
    "hard": {
      "weight": 0.4,
      "threshold": 0.92,
      "fields": [
        "original",
        "type",
        "clauses[].clause_type",
        "clauses[].subordinator",
        "clauses[].relative_pronoun",
        "clauses[].subject.type",
        "clauses[].subject.text"
      ]
    },
    "structure": {
      "weight": 0.35,
      "threshold": 0.85,
      "fields": [
        "clauses[].predicate.verb",
        "clauses[].predicate.auxiliary",
        "clauses[].object.type",
        "clauses[].complement.type",
        "clauses[].predicate.modifiers[].preposition",
        "clauses[].adverbials[].preposition"
      ]
    },
    "soft": {
      "weight": 0.25,
      "threshold": 0.70,
      "fields": [
        "clauses[].predicate.modifiers[].function",
        "clauses[].adverbials[].function",
        "relations"
      ]
    }
  },
  "thresholds": {
    "single_sentence_min": 0.85,
    "average_min": 0.88,
    "hard_fields_min": 0.92
  },
  "normalization": {
    "text": {
      "lowercase": true,
      "strip_whitespace": true,
      "punctuation_variants": {
        "\u2014": "-",
        "\u2013": "-",
        "\u2018": "'",
        "\u2019": "'",
        "\u201c": "\"",
        "\u201d": "\""
      },
      "article_equivalence": ["a", "an", "the"]
    },
    "type_labels": {
      "aliases": {
        "dummy pronoun": ["expletive", "formal subject placeholder"],
        "formal subject": ["dummy subject", "it-placeholder"],
        "noun_clause": ["noun clause", "nominal clause"],
        "infinitive_phrase": ["infinitive phrase", "to-infinitive"],
        "prepositional_phrase": ["PP", "prep phrase"],
        "adjective_phrase": ["AdjP", "adjectival phrase"]
      }
    }
  },
  "soft_field_keywords": {
    "relations": {
      "scoring_method": "keyword_coverage",
      "key_terms": [
        "governs",
        "modifies",
        "complement",
        "adverbial",
        "clause",
        "object",
        "subject",
        "antecedent",
        "relative",
        "subordinate",
        "coordinate",
        "takes",
        "provides"
      ]
    },
    "function": {
      "scoring_method": "keyword_match",
      "valid_terms": [
        "content",
        "recipient",
        "time",
        "place",
        "manner",
        "degree",
        "topic",
        "reason",
        "purpose"
      ]
    }
  },
  "golden_fixture_path": "fixtures/golden_cases.json",
  "scorer_entry": "ega_score.py"
}

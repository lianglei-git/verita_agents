{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sentence.analyze LS output",
  "description": "按 api_version 原样交出 analysis。v1/v2/v3 结构不同；LS 只存和展示。禁止 activity_id。",
  "type": "object",
  "required": ["api_version", "analysis", "target_lang", "explain_lang", "meta"],
  "additionalProperties": true,
  "properties": {
    "api_version": { "type": "string", "enum": ["v1", "v2", "v3"] },
    "analysis": { "type": "object" },
    "spacy_tokens": { "type": "array" },
    "target_lang": { "type": "string" },
    "explain_lang": { "type": "string" },
    "meta": {
      "type": "object",
      "required": ["agent", "status", "package_version", "api_version"],
      "properties": {
        "agent": { "type": "string" },
        "profile": { "type": "string" },
        "status": { "type": "string" },
        "package_version": { "type": "string" },
        "api_version": { "type": "string", "enum": ["v1", "v2", "v3"] },
        "user_level": { "type": "string" },
        "goal": { "type": "string" }
      },
      "not": { "required": ["activity_id"] }
    }
  }
}

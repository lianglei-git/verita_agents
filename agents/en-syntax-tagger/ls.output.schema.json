{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sentence.analyze output (sentence/1.0)",
  "type": "object",
  "required": [
    "target_lang",
    "explain_lang",
    "profile",
    "tree",
    "trunk",
    "constituent_table",
    "translation",
    "i18n",
    "meta"
  ],
  "additionalProperties": true,
  "properties": {
    "target_lang": { "type": "string" },
    "explain_lang": { "type": "string" },
    "profile": { "type": "string" },
    "sentence_type": { "type": "string" },
    "tree": { "type": "string" },
    "trunk": { "type": "object" },
    "modifiers": { "type": "array" },
    "constituent_table": { "type": "array" },
    "special_structures": { "type": "object" },
    "semantic_roles": { "type": "array" },
    "translation": { "type": "string" },
    "i18n": { "type": "object" },
    "meta": {
      "type": "object",
      "required": ["agent", "profile", "status", "package_version", "api_version"],
      "properties": {
        "agent": { "type": "string" },
        "profile": { "type": "string" },
        "status": { "type": "string" },
        "package_version": { "type": "string" },
        "api_version": { "type": "string" },
        "user_level": { "type": "string" },
        "goal": { "type": "string" }
      },
      "not": { "required": ["activity_id"] }
    }
  }
}

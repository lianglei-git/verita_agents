{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EnSyntaxTaggerV1Output",
  "description": "v1 详细学术版：主干 + 修饰 + 特殊结构 + 树 + 成分表",
  "type": "object",
  "required": ["input", "api_version", "analysis", "spacy_tokens", "meta"],
  "properties": {
    "input": { "type": "string" },
    "api_version": { "const": "v1" },
    "output": { "type": "string" },
    "error": { "type": ["string", "null"] },
    "message": { "type": "string" },
    "analysis": {
      "type": "object",
      "properties": {
        "sentence": { "type": "string" },
        "translation": { "type": "string" },
        "sentence_type": { "type": "string" },
        "trunk": { "type": "object" },
        "modifiers": { "type": "array" },
        "special_structures": { "type": "object" },
        "tree": { "type": "string" },
        "constituent_table": { "type": "array" },
        "semantic_roles": { "type": "array" }
      }
    },
    "spacy_tokens": { "type": "array" },
    "meta": {
      "type": "object",
      "properties": {
        "api_version": { "const": "v1" },
        "profile": { "const": "academic" },
        "llm_status": { "type": "string" },
        "spacy_status": { "type": "string" }
      }
    }
  }
}

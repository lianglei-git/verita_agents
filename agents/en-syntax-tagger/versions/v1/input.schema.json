{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EnSyntaxTaggerV1Input",
  "description": "v1 详细学术版输入",
  "type": "object",
  "required": ["sentence"],
  "additionalProperties": true,
  "properties": {
    "sentence": {
      "type": "string",
      "minLength": 1,
      "description": "待分析原句（语言由 learn_lang 指定）"
    },
    "native_lang": {
      "type": "string",
      "default": "中文",
      "description": "学习者母语；翻译与讲解用语"
    },
    "learn_lang": {
      "type": "string",
      "default": "英语",
      "description": "目标学习语言；被分析句子语言"
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EnSyntaxTaggerEnvelope",
  "description": "外壳。analysis 形状见 versions/v{1,2,3}/output.schema.json",
  "type": "object",
  "properties": {
    "input": { "type": "string" },
    "api_version": { "type": "string", "enum": ["v1", "v2", "v3"] },
    "output": { "type": "string" },
    "error": { "type": ["string", "null"] },
    "message": { "type": "string" },
    "analysis": { "type": "object" },
    "spacy_tokens": { "type": "array" },
    "meta": { "type": "object" }
  },
  "version_docs": {
    "v1": {
      "profile": "academic",
      "solves": "详细学术版：标准缩写+成分表+树形+特殊结构",
      "prompt": "versions/v1/prompt.txt"
    },
    "v2": {
      "profile": "teaching",
      "solves": "对比学习版：片段表+主干概括+难点说明",
      "prompt": "versions/v2/prompt.txt"
    },
    "v3": {
      "profile": "json_data",
      "solves": "JSON数据版：带字符下标的 constituents/clauses，便于程序处理",
      "prompt": "versions/v3/prompt.txt"
    }
  }
}
